# =========================================================
# Nanotap Loyalty — variables de entorno
# Copiar a .env (local) o cargar en el panel del hosting.
# NUNCA subir .env ni certificados al repositorio.
# =========================================================

# Servidor
PORT=3000
# URL pública con HTTPS. Apple y Google la usan para descargar imágenes
# y (Apple) para llamar al web service. En local usar un túnel (ngrok, cloudflared).
BASE_URL=https://loyalty.nanotap.cr
# production: fuerza HTTPS. En local usar development.
NODE_ENV=production

# Supabase (usar la service_role key; solo vive en el servidor)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Autenticación
JWT_SECRET=                 # al menos 32 caracteres aleatorios
OPERADOR_PASSWORD=          # contraseña del panel del operador (/operador)

# Correo que se muestra en el aviso de privacidad para solicitudes de la Ley 8968
CONTACTO_PRIVACIDAD=privacidad@nanotap.cr

# Apple Wallet (opcional hasta la Fase 3: si faltan, el botón de Apple no se muestra)
APPLE_PASS_TYPE_IDENTIFIER=pass.cr.nanotap.loyalty
APPLE_TEAM_IDENTIFIER=
APPLE_WWDR_CERT_BASE64=     # certificado intermedio WWDR de Apple (PEM o DER), en base64
APPLE_SIGNER_CERT_BASE64=   # certificado del Pass Type ID (PEM), en base64
APPLE_SIGNER_KEY_BASE64=    # llave privada del Pass Type ID (PEM), en base64
APPLE_SIGNER_KEY_PASSPHRASE=
# Opcional: push por token (.p8). Si se dejan vacías, el push a APNs usa el
# certificado del Pass Type ID (método documentado por Apple para Wallet).
APPLE_APNS_KEY_BASE64=
APPLE_APNS_KEY_ID=

# Google Wallet (opcional: si faltan, el botón de Google no se muestra)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
